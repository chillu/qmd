<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tailscale.serve.pkm</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>sleep 30 &amp;&amp; /Applications/Tailscale.app/Contents/MacOS/Tailscale serve --bg --set-path=/qmd 127.0.0.1:8181 &amp;&amp; /Applications/Tailscale.app/Contents/MacOS/Tailscale serve --bg --set-path=/mcpvault 127.0.0.1:8182</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/tmp/tailscale-serve-pkm.log</string>
    
    <key>StandardErrorPath</key>
    <string>/tmp/tailscale-serve-pkm.error.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/Applications/Tailscale.app/Contents/MacOS</string>
    </dict>
</dict>
</plist>
