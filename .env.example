# Jina AI Configuration (required for pluginmd/qmd remote embeddings + reranking)
JINA_API_KEY=jina_your_api_key_here
QMD_EMBED_PROVIDER=jina
QMD_RERANK_PROVIDER=jina

# Path to your Obsidian vault (required for docker-compose.yml)
# IMPORTANT: Do NOT use quotes around the path in this file!
VAULT_PATH=/path/to/your/obsidian/vault
