# OpenAI Configuration (required for QMD remote embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# QMD OpenAI-compatible backend settings
QMD_LLM_PROVIDER=openai-compatible
QMD_OPENAI_BASE_URL=https://api.openai.com/v1
QMD_EMBED_MODEL=text-embedding-3-small
QMD_GENERATE_MODEL=gpt-4o-mini

# Path to your Obsidian vault (required for docker-compose.yml)
# IMPORTANT: Do NOT use quotes around the path in this file!
VAULT_PATH=/path/to/your/obsidian/vault
